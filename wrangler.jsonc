{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slp-site",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "keep_vars": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "slp-db", "database_id": "c34e8fe6-a869-40cb-961b-778d03fca13b" },
    { "binding": "SUPERNOVA_DB", "database_name": "supernova-db", "database_id": "095af135-021d-4c3a-8cae-d55ddf61d2f5" }
  ],
  "triggers": { "crons": ["30 5 * * *"] },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "b14e32031b5a4d439208f0f8d4f3f71d",
      "secret_name": "RESEND_API_KEY"
    }
  ]
}
